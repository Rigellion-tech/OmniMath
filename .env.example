# OpenAI
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
# Legacy global selector. Prefer explicit role variables below; this no longer
# overrides solver, repair, escalation, or image extraction defaults.
OPENAI_MODEL=
OPENAI_LAZY_MODEL=
OPENAI_IMAGE_EXTRACTION_MODEL=
OPENAI_EXTRACTION_REVIEW_MODEL=
OPENAI_SOLVER_MODEL=
OPENAI_REPAIR_MODEL=
OPENAI_ESCALATION_MODEL=
OPENAI_PREMIUM_ESCALATION_MODEL=
OPENAI_HOVER_MODEL=
OPENAI_PINNED_MODEL=

# Preferred role-specific model overrides
# Current role defaults:
# - solver: gpt-5.6-luna
# - repair: gpt-5.6-terra
# - escalation and premium escalation: gpt-5.6-sol
# - image extraction: gpt-4.1
# - extraction review, hover, pinned explanations: gpt-4.1-mini
OMNIMATH_IMAGE_EXTRACTION_MODEL=
OMNIMATH_EXTRACTION_REVIEW_MODEL=
OMNIMATH_SOLVER_MODEL=
OMNIMATH_SOLVER_REASONING_EFFORT=
OMNIMATH_REPAIR_MODEL=
OMNIMATH_REPAIR_REASONING_EFFORT=
OMNIMATH_ESCALATION_MODEL=
OMNIMATH_ESCALATION_REASONING_EFFORT=
OMNIMATH_PREMIUM_ESCALATION_MODEL=
OMNIMATH_PREMIUM_ESCALATION_REASONING_EFFORT=
OMNIMATH_HOVER_MODEL=
OMNIMATH_PINNED_MODEL=

# Token, timeout, and cost controls
OMNIMATH_DEFAULT_INPUT_COST_PER_1M_TOKENS=
OMNIMATH_DEFAULT_OUTPUT_COST_PER_1M_TOKENS=
OCR_REVIEW_CONFIDENCE_THRESHOLD=35
OPENAI_MAX_OUTPUT_TOKENS=8000
OPENAI_SOLVE_MAX_OUTPUT_TOKENS=6500
OMNIMATH_SOLVER_MAX_OUTPUT_TOKENS=6500
OMNIMATH_SOLVER_COMPACT_MAX_OUTPUT_TOKENS=3200
OMNIMATH_REPAIR_MAX_OUTPUT_TOKENS=16000
OMNIMATH_REPAIR_COMPACT_MAX_OUTPUT_TOKENS=8000
OMNIMATH_ESCALATION_MAX_OUTPUT_TOKENS=24000
OMNIMATH_ESCALATION_COMPACT_MAX_OUTPUT_TOKENS=12000
OMNIMATH_PREMIUM_ESCALATION_MAX_OUTPUT_TOKENS=24000
OMNIMATH_PREMIUM_ESCALATION_COMPACT_MAX_OUTPUT_TOKENS=12000
OPENAI_LAZY_MAX_OUTPUT_TOKENS=700
OPENAI_IMAGE_EXTRACTION_MAX_OUTPUT_TOKENS=800
OPENAI_IMAGE_TOKEN_ESTIMATE=1700
OMNIMATH_OPENAI_SOLVER_TIMEOUT_MS=60000
# Total wall-clock budget shared by the initial solve, transport retries, and compact structural retry.
OMNIMATH_SOLVE_TOTAL_TIMEOUT_MS=75000
OMNIMATH_OPENAI_REPAIR_TIMEOUT_MS=120000
OMNIMATH_OPENAI_ESCALATION_TIMEOUT_MS=180000
OMNIMATH_OPENAI_PREMIUM_ESCALATION_TIMEOUT_MS=180000
OMNIMATH_OPENAI_IMAGE_EXTRACTION_TIMEOUT_MS=60000
OMNIMATH_OPENAI_EXTRACTION_REVIEW_TIMEOUT_MS=60000
OMNIMATH_OPENAI_LAZY_TIMEOUT_MS=30000
OPENAI_RETRY_BASE_DELAY_MS=500
OPENAI_INPUT_COST_PER_1M_TOKENS=5
OPENAI_OUTPUT_COST_PER_1M_TOKENS=30

# Backend diagnostics and controls
# Optional immutable deployment/build cohort for solve telemetry. In hosted CI,
# common Git/deployment IDs are also detected; package.json version is the fallback.
OMNIMATH_BUILD_ID=
ENABLE_OPENAI_DEBUG_ROUTE=false
OMNIMATH_DEBUG_SOLVE=false
OMNIMATH_DEBUG_MATH_PIPELINE=false
OMNIMATH_DEBUG_REASONING_LATEX=false
OMNIMATH_DEBUG_REASONING_LATEX_STEPS=1,2
OMNIMATH_CAPTURE_FAILED_SOLVES=0
AI_ENABLED=true
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_HOUR=100
DAILY_SPEND_LIMIT_USD=2
MONTHLY_SPEND_LIMIT_USD=50
DAILY_AI_LIMIT=50
DAILY_TOKEN_LIMIT=200000
MONTHLY_AI_LIMIT=1000
MONTHLY_TOKEN_LIMIT=2000000
FREE_DAILY_USER_LIMIT=25
FREE_MONTHLY_USER_LIMIT=750
LOGGED_IN_DAILY_USER_LIMIT=100
LOGGED_IN_MONTHLY_USER_LIMIT=3000

# Frontend auth and debug flags
VITE_AUTH_MODE=
VITE_DISABLE_AUTH=false
VITE_ENABLE_HIERARCHICAL_TOKENS=true
VITE_SEMANTIC_MATH_AST=true
VITE_DEBUG_MATH_HITBOXES=false
VITE_DEBUG_MATH_HOVER=false
VITE_DEBUG_SEMANTIC_HITBOXES=false
VITE_DEBUG_HOVER_TARGETS=false
VITE_DEBUG_MATH_HOVER_PERF=false
VITE_DEBUG_MATH_RENDER=false
VITE_DEBUG_MATH_PIPELINE=false
VITE_DEBUG_SOLUTION_STATE=false
VITE_DEBUG_REASONING_LATEX=false
VITE_DEBUG_REASONING_LATEX_STEPS=1,2
VITE_CLERK_PUBLISHABLE_KEY=

# Clerk
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
CLERK_TIER_CLAIM=omnimath_tier

# Persistence
DATABASE_URL=
DATABASE_SSL=
DATABASE_POOL_MAX=3

# Local development
PORT=8787
VITE_PORT=5173
DEV_API_TARGET=http://127.0.0.1:8787
DEV_CLIENT_ORIGIN=http://localhost:5173
USAGE_LOCAL_STORE_PATH=

# Production usage-counter store
USAGE_KV_REST_API_URL=
USAGE_KV_REST_API_TOKEN=
USAGE_IDENTITY_HMAC_SECRET=

# Script-only options
OMNIMATH_E2E_BROWSER_PATH=
OMNIMATH_TEST_ENDPOINT=
OMNIMATH_TEST_AUTH_TOKEN=
OMNIMATH_BENCHMARK_EFFICIENT_REASONING_MODEL=
OMNIMATH_BENCHMARK_STRONG_REASONING_MODEL=
